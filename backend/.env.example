# ─────────────────────────────────────────────────────────────
# Job Hunter Pro — Backend environment
# Copy to .env and fill in. On Railway, set these as service variables.
# ─────────────────────────────────────────────────────────────

# Supabase Postgres connection string (REQUIRED).
# Supabase dashboard → Project Settings → Database → Connection string → "URI".
# Use the "Session pooler" / direct URI. Make sure to include the password.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Allowed frontend origin(s) for CORS — your Vercel URL. Comma-separate for multiple.
# Leave unset for local dev (http://localhost:3000 is always allowed).
ALLOWED_ORIGIN=https://your-app.vercel.app

# Port the API listens on (Railway sets this automatically).
PORT=4000

# Contact email used in Web Push (VAPID) — required by the push spec.
PUSH_CONTACT_EMAIL=you@example.com

# ── Optional API keys (scrapers degrade gracefully if missing) ──

# RapidAPI key for JSearch (LinkedIn/Indeed/Glassdoor aggregation, every 12h).
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# RapidAPI key for Fantastic.jobs "Active Jobs DB" — broad feed aggregated from
# company ATS boards (Greenhouse/Lever/Ashby/Workday). Optional, every 12h.
# Can reuse the same RapidAPI key value if subscribed to both APIs.
# https://rapidapi.com/fantastic-jobs-fantastic-jobs-default/api/active-jobs-db
FANTASTIC_API_KEY=

# Adzuna API (extra coverage). https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Set PGSSL=false only for a local Postgres without SSL. Supabase requires SSL (default on).
# PGSSL=false
