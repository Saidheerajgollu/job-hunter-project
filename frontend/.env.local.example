# Job Hunter Pro — Frontend environment
# Copy to .env.local for local dev. On Vercel, set as Environment Variables.
#
# SECURITY: Only NEXT_PUBLIC_* vars belong here. They are bundled into the browser.
# Never put DATABASE_URL, CONTEXT_DEV_API_KEY, or other secrets in the frontend.

# Backend API base URL (include /api suffix) — not a secret, just your server URL
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Production example:
# NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app/api
